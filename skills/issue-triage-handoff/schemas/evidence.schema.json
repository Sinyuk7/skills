{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Attachment",
  "description": "Full evidence inventory with complete content (companion to handoff summary)",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "evidence_inventory"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "handoff_id": {
      "type": "string",
      "description": "Links to parent handoff summary"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "source_ref", "content"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^E[0-9]{3}$" },
          "type": {
            "enum": [
              "log_entry",
              "stacktrace",
              "comment",
              "chat_message",
              "config",
              "metric",
              "screenshot",
              "video",
              "image"
            ]
          },
          "source_ref": {
            "type": "object",
            "required": ["source_type"],
            "properties": {
              "source_type": { "enum": ["file", "url", "inline"] },
              "path": { "type": "string" },
              "line_start": { "type": ["integer", "null"] },
              "line_end": { "type": ["integer", "null"] }
            }
          },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "content": { 
            "type": "string",
            "minLength": 1,
            "description": "REQUIRED in evidence attachment. Full original content."
          },
          "content_size_bytes": { 
            "type": "integer",
            "description": "Size of content field for large content tracking"
          },
          "content_truncated": {
            "type": "boolean",
            "description": "True if content was truncated due to size limits"
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "extraction_metadata": {
            "type": "object",
            "properties": {
              "extracted_at": { "type": "string", "format": "date-time" },
              "extraction_tool": { "type": "string" },
              "extraction_status": { "enum": ["success", "partial", "failed"] },
              "extraction_notes": { "type": "string" }
            }
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "total_evidence_count": { "type": "integer" },
        "total_size_bytes": { "type": "integer" },
        "type_breakdown": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    }
  }
}
