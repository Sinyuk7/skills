#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
SKILL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PYTHON_IMPL="$SKILL_ROOT/scripts/case_state.py"

if [[ ! -f "$PYTHON_IMPL" ]]; then
  printf 'case-state wrapper error: missing implementation: %s\n' "$PYTHON_IMPL" >&2
  exit 1
fi

exec python3 "$PYTHON_IMPL" "$@"
