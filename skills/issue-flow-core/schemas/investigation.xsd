<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="investigation">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="evidence_refs" type="EvidenceRefsType"/>
        <xs:element name="evidence_excerpts" type="EvidenceExcerptsType"/>
        <xs:element name="confirmed" type="ConfirmedType"/>
        <xs:element name="inferred" type="InferredType"/>
        <xs:element name="open_questions" type="OpenQuestionsType"/>
        <xs:element name="details" type="DetailsType"/>
      </xs:sequence>
      <xs:attribute name="case-id" type="xs:string" use="required"/>
      <xs:attribute name="timestamp" type="xs:dateTime" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:complexType name="EvidenceRefsType">
    <xs:sequence>
      <xs:element name="issue_material" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="path" type="xs:string" use="required"/>
          <xs:attribute name="type" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="repository_ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="type" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="file"/>
                <xs:enumeration value="symbol"/>
                <xs:enumeration value="line_range"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="path" type="xs:string" use="required"/>
          <xs:attribute name="symbol" type="xs:string"/>
          <xs:attribute name="line" type="xs:integer"/>
          <xs:attribute name="start" type="xs:integer"/>
          <xs:attribute name="end" type="xs:integer"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="EvidenceExcerptsType">
    <xs:sequence>
      <xs:element name="log_excerpt" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="id" type="xs:string" use="required"/>
              <xs:attribute name="source" type="xs:string" use="required"/>
              <xs:attribute name="lines" type="xs:string" use="required"/>
              <xs:attribute name="timestamp" type="xs:dateTime"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="ConfirmedType">
    <xs:sequence>
      <xs:element name="fact" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="id" type="xs:string" use="required"/>
              <xs:attribute name="ref" type="xs:string" use="required"/>
              <xs:attribute name="source_excerpt" type="xs:string"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="InferredType">
    <xs:sequence>
      <xs:element name="inference" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="id" type="xs:string" use="required"/>
              <xs:attribute name="basis" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="OpenQuestionsType">
    <xs:sequence>
      <xs:element name="question" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="id" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="DetailsType">
    <xs:sequence>
      <xs:element name="section" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="title" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
