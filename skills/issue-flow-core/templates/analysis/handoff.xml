<?xml version="1.0" encoding="UTF-8"?>
<handoff case-id="{{case_id}}" timestamp="{{timestamp}}">
  <summary>
    <!-- Concise downstream summary (2-4 paragraphs) -->
    {{summary}}
  </summary>

  <!-- ENHANCED code_context with evidence traceability -->
  <code_context>
    <!-- Relevant repository context as direct references -->
    <affected_files>
      <file path="{{file_path}}" reason="{{reason}}" />
      <file path="{{file_path}}" reason="{{reason}}" />
    </affected_files>
    
    <!-- key_symbols now include evidence attribute for traceability -->
    <key_symbols>
      <symbol path="{{file_path}}" name="{{symbol}}" line="{{line}}" evidence="{{evidence_ids}}" />
      <symbol path="{{file_path}}" name="{{symbol}}" line="{{line}}" evidence="{{evidence_ids}}" />
    </key_symbols>
    
    <critical_sections>
      <section path="{{file_path}}" start="{{start}}" end="{{end}}" note="{{note}}" />
    </critical_sections>
  </code_context>

  <!-- MANDATORY traceability - every known item MUST reference investigation fact ID -->
  <known>
    <!-- What is definitively known -->
    <!-- REQUIRED: fact_ref="F-001" must point to investigation.xml fact ID -->
    <item fact_ref="F-{{n}}">{{known_item}}</item>
    <item fact_ref="F-{{n}}">{{known_item}}</item>
  </known>

  <!-- next_step section -->
  <next_step>
    <recommended_action>{{resolve|collect|external|none|blocked}}</recommended_action>
    <confidence>{{high|medium|low}}</confidence>
    <solution_approved>{{true|false}}</solution_approved>
    <reasoning>
      {{reasoning}}
    </reasoning>
    <prerequisites>
      <item>{{prerequisite}}</item>
      <item>{{prerequisite}}</item>
    </prerequisites>
    <notes>
      {{additional_notes}}
    </notes>
  </next_step>

  <investigation_ref>
    <!-- Pointer to full investigation record -->
    analysis/investigation.xml
  </investigation_ref>
  
  <issue_context_ref>
    <!-- Pointer to project-level context if used; keep this pointed at <repo-root>/ISSUE_CONTEXT.md -->
    ISSUE_CONTEXT.md
  </issue_context_ref>
</handoff>
