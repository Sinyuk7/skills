<?xml version="1.0" encoding="UTF-8"?>
<investigation case-id="{{case_id}}" timestamp="{{timestamp}}">
  <evidence_refs>
    <!-- Pointers to curated materials in curated/ -->
    <issue_material id="{{source_id}}" path="curated/{{path}}" type="{{type}}" />
    <issue_material id="{{source_id}}" path="curated/{{path}}" type="{{type}}" />
    
    <!-- Repository evidence as direct references -->
    <repository_ref type="file" path="{{file_path}}" />
    <repository_ref type="symbol" path="{{file_path}}" symbol="{{symbol_name}}" line="{{line}}" />
    <repository_ref type="line_range" path="{{file_path}}" start="{{start}}" end="{{end}}" />
  </evidence_refs>

  <!-- REQUIRED: Evidence excerpts proving logs were read -->
  <evidence_excerpts>
    <!-- For each log file referenced above, include 1-2 representative lines -->
    <!-- This proves the log was actually read and analyzed, not just referenced -->
    <!-- REQUIRED attributes: id, source, lines -->
    <!-- OPTIONAL attribute: timestamp (helps human reviewers locate context) -->
    <log_excerpt id="{{excerpt_id}}" source="curated/logs/{{log_name}}" lines="{{start}}-{{end}}" timestamp="{{timestamp_optional}}">
      {{actual_log_content_line_1}}
      {{actual_log_content_line_2}}
    </log_excerpt>
  </evidence_excerpts>

  <!-- FACT OF RECORD: All downstream facts MUST reference these -->
  <!-- Every fact, inference, and question MUST have an ID for traceability -->
  <confirmed>
    <!-- Facts verified from evidence -->
    <!-- MANDATORY: Every fact MUST have id="F-001", id="F-002", etc. -->
    <!-- When referencing log evidence, source_excerpt must point to an excerpt from that same log file -->
    <fact id="F-{{n}}" ref="{{evidence_id}}" source_excerpt="{{excerpt_id}}">{{confirmed_fact}}</fact>
    <fact id="F-{{n}}" ref="{{evidence_id}}">{{confirmed_fact}}</fact>
  </confirmed>

  <inferred>
    <!-- Conclusions drawn from evidence -->
    <!-- MANDATORY: Every inference MUST have id="I-001", id="I-002", etc. -->
    <inference id="I-{{n}}" basis="{{evidence_ids}}">{{inference}}</inference>
    <inference id="I-{{n}}" basis="{{evidence_ids}}">{{inference}}</inference>
  </inferred>

  <open_questions>
    <!-- Unresolved questions from investigation -->
    <!-- MANDATORY: Every question MUST have id="Q-001", id="Q-002", etc. -->
    <question id="Q-{{n}}">{{question}}</question>
    <question id="Q-{{n}}">{{question}}</question>
  </open_questions>

  <details>
    <!-- Expanded analysis and narrative context -->
    <section title="{{title}}">
      {{analysis}}
    </section>
    
    <section title="{{title}}">
      {{analysis}}
    </section>
  </details>
</investigation>
